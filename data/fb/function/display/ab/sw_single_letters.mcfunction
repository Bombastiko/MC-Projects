# Formats and displays the stopwatch in the actionbar with letters (e.g. [Prefix] 1d 5h 30m 15s [Suffix])
# Context: fb:config display.$(player).ab
# Macro parameters: $(player), $(sw), $(color), $(color_sec), $(color_num), $(prefix), $(suffix), $(bold)

$title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.d"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "d ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "h ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "m ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "s", "color": "$(color_sec)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]
