$execute if data storage fb:config {debug:{sw:1b}} run tellraw @a [{"text": "[FB DEBUG] sw_single_digital_short for ", "color": "gray"}, {"text": "$(player)", "color": "white"}]

# Active Style
$execute if data storage fb:main sw.list[{name:"$(sw)"}] run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ".", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.ms"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.ms"}, "color": "$(color_num)", "bold": $(bold)}, {"text": "$(suffix)", "color": "$(color)", "bold": $(bold)}]

# Paused Style (Gray & Italic)
$execute unless data storage fb:main sw.list[{name:"$(sw)"}] run title $(player) actionbar ["", {"text": "$(prefix)", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": ":", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": ".", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.ms"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(sw)", "objective": "fb.sw.ms"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": "$(suffix)", "color": "gray", "bold": $(bold), "italic": true}]
