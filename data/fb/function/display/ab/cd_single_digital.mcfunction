# Active Display (state == 0 and in cd.list)
$execute if score #$(cd) fb.cd.state matches 0 if data storage fb:main cd.list[{name:"$(cd)"}] run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": $(bold)}, {"score": {"name": "#$(cd)", "objective": "fb.cd.h"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(cd)-e", "objective": "fb.cd.m"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(cd)", "objective": "fb.cd.m"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(cd)-e", "objective": "fb.cd.s"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(cd)", "objective": "fb.cd.s"}, "color": "$(color_num)", "bold": $(bold)}, {"text": "$(suffix)", "color": "$(color)", "bold": $(bold)}]

# Paused Display (state == 0 and not in cd.list)
$execute if score #$(cd) fb.cd.state matches 0 unless data storage fb:main cd.list[{name:"$(cd)"}] run title $(player) actionbar ["", {"text": "$(prefix)", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(cd)", "objective": "fb.cd.h"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": ":", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(cd)-e", "objective": "fb.cd.m"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(cd)", "objective": "fb.cd.m"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": ":", "color": "gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(cd)-e", "objective": "fb.cd.s"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"score": {"name": "#$(cd)", "objective": "fb.cd.s"}, "color": "dark_gray", "bold": $(bold), "italic": true}, {"text": "$(suffix)", "color": "gray", "bold": $(bold), "italic": true}]
