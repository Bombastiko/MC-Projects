$execute if data storage fb:config {debug: 1b} run tellraw @a [{"text": "[FB DEBUG] sw_single_digital for ", "color": "gray"}, {"text": "$(player)", "color": "white"}]

# Active Style - Days > 0
$execute if data storage fb:main sw.list[{name:"$(sw)"}] if score #$(sw) fb.sw.d matches 1.. run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.d"}, "color": "$(color_num)", "bold": $(bold)}, {"text": "d ", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"text": "$(suffix)", "color": "$(color)", "bold": $(bold)}]

# Active Style - Days == 0
$execute if data storage fb:main sw.list[{name:"$(sw)"}] if score #$(sw) fb.sw.d matches 0 run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": $(bold)}, {"text": ":", "color": "$(color_sec)", "bold": $(bold)}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": $(bold)}, {"text": "$(suffix)", "color": "$(color)", "bold": $(bold)}]

