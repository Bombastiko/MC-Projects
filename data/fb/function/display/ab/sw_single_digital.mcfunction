# Formats and displays the stopwatch in the actionbar digitally (e.g. [Prefix] 1d 05:30:15 [Suffix] or [Prefix] 05:30:15 [Suffix])
# Context: fb:config display.$(player).ab
# Macro parameters: $(player), $(sw), $(color), $(color_sec), $(color_num), $(prefix), $(suffix), $(bold)

# Days > 0: Show days as 'Xd' and then 'hh:mm:ss'
$execute if score #$(sw) fb.sw.d matches 1.. run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.d"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "d ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": ":", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": ":", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]

# Days == 0: Show 'hh:mm:ss'
$execute if score #$(sw) fb.sw.d matches 0 run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": ":", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": ":", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)-e", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]
