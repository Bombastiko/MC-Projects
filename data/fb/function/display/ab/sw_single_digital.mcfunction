# Formats and displays the stopwatch in the actionbar digitally (e.g. [Prefix] 1d 05:30:15 [Suffix] or [Prefix] 05:30:15 [Suffix])
# Context: fb:config display.$(player)
# Macro parameters: $(player), $(ab.sw), $(ab.color), $(ab.color_sec), $(ab.color_num), $(ab.prefix), $(ab.suffix), $(ab.bold)

# Days > 0: Show days as 'Xd' and then 'hh:mm:ss'
$execute if score #$(ab.sw) fb.sw.d matches 1.. run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.d"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "d ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": ":", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": ":", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]

# Days == 0: Show 'hh:mm:ss'
$execute if score #$(ab.sw) fb.sw.d matches 0 run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": ":", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": ":", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)-e", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]
