# Formats and displays the stopwatch in the actionbar dynamically (hiding zero units)
# Context: fb:config display.$(player)
# Macro parameters: $(player), $(ab.sw), $(ab.color), $(ab.color_sec), $(ab.color_num), $(ab.prefix), $(ab.suffix), $(ab.bold)

# Case 1: Days > 0 -> Show Days, Hours, Minutes, Seconds
$execute if score #$(ab.sw) fb.sw.d matches 1.. run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.d"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "d ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "h ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "m ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "s", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]

# Case 2: Days == 0, Hours > 0 -> Show Hours, Minutes, Seconds
$execute if score #$(ab.sw) fb.sw.d matches 0 if score #$(ab.sw) fb.sw.h matches 1.. run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.h"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "h ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "m ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "s", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]

# Case 3: Days == 0, Hours == 0, Minutes > 0 -> Show Minutes, Seconds
$execute if score #$(ab.sw) fb.sw.d matches 0 if score #$(ab.sw) fb.sw.h matches 0 if score #$(ab.sw) fb.sw.m matches 1.. run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.m"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "m ", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "s", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]

# Case 4: Days == 0, Hours == 0, Minutes == 0 -> Show Seconds only
$execute if score #$(ab.sw) fb.sw.d matches 0 if score #$(ab.sw) fb.sw.h matches 0 if score #$(ab.sw) fb.sw.m matches 0 run title $(player) actionbar ["", {"text": "$(ab.prefix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}, {"score": {"name": "#$(ab.sw)", "objective": "fb.sw.s"}, "color": "$(ab.color_num)", "bold": "$(ab.bold)"}, {"text": "s", "color": "$(ab.color_sec)", "bold": "$(ab.bold)"}, {"text": "$(ab.suffix)", "color": "$(ab.color)", "bold": "$(ab.bold)"}]
