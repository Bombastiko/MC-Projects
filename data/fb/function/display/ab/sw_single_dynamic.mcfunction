# Formats and displays the stopwatch in the actionbar dynamically (hiding zero units)
# Context: fb:config display.$(player).ab
# Macro parameters: $(player), $(sw), $(color), $(color_sec), $(color_num), $(prefix), $(suffix), $(bold)

# Case 1: Days > 0 -> Show Days, Hours, Minutes, Seconds
$execute if score #$(sw) fb.sw.d matches 1.. run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.d"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "d ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "h ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "m ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "s", "color": "$(color_sec)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]

# Case 2: Days == 0, Hours > 0 -> Show Hours, Minutes, Seconds
$execute if score #$(sw) fb.sw.d matches 0 if score #$(sw) fb.sw.h matches 1.. run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.h"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "h ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "m ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "s", "color": "$(color_sec)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]

# Case 3: Days == 0, Hours == 0, Minutes > 0 -> Show Minutes, Seconds
$execute if score #$(sw) fb.sw.d matches 0 if score #$(sw) fb.sw.h matches 0 if score #$(sw) fb.sw.m matches 1.. run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.m"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "m ", "color": "$(color_sec)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "s", "color": "$(color_sec)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]

# Case 4: Days == 0, Hours == 0, Minutes == 0 -> Show Seconds only
$execute if score #$(sw) fb.sw.d matches 0 if score #$(sw) fb.sw.h matches 0 if score #$(sw) fb.sw.m matches 0 run title $(player) actionbar ["", {"text": "$(prefix)", "color": "$(color)", "bold": "$(bold)"}, {"score": {"name": "#$(sw)", "objective": "fb.sw.s"}, "color": "$(color_num)", "bold": "$(bold)"}, {"text": "s", "color": "$(color_sec)", "bold": "$(bold)"}, {"text": "$(suffix)", "color": "$(color)", "bold": "$(bold)"}]
