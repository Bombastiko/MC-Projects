# Stopwatch debug info
tellraw @a ["", {"text": "=== FuseBox Stopwatch Debug Info ===", "color": "yellow", "bold": true}]
tellraw @a ["", {"text": "Active Stopwatches (sw.list): ", "color": "gold"}, {"nbt": "sw.list", "storage": "fb:main", "color": "white"}]
tellraw @a ["", {"text": "Active Players (players): ", "color": "gold"}, {"nbt": "players", "storage": "fb:config", "color": "white"}]
