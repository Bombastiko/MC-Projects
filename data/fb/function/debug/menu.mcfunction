# Print FuseBox Debug Menu
# Executed as player

tellraw @s ["", {"text": "\n=== FuseBox Debug Menu ===\n", "color": "yellow", "bold": true}]

# 1. Global Debug Row
execute if data storage fb:config {debug:{global:1b}} run tellraw @s ["", {"text": "  Global: ", "color": "gold"}, {"text": "[ENABLED] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 1"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 1"}}]
execute unless data storage fb:config {debug:{global:1b}} run tellraw @s ["", {"text": "  Global: ", "color": "gold"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 1"}}, {"text": "[DISABLED]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 1"}}]

# 2. Stopwatch Row
execute if data storage fb:config {debug:{sw:1b}} run tellraw @s ["", {"text": "  Stopwatch: ", "color": "gold"}, {"text": "[ENABLED] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 2"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 2"}}]
execute unless data storage fb:config {debug:{sw:1b}} run tellraw @s ["", {"text": "  Stopwatch: ", "color": "gold"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 2"}}, {"text": "[DISABLED]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 2"}}]

# 3. Countdown Row
execute if data storage fb:config {debug:{cd:1b}} run tellraw @s ["", {"text": "  Countdown: ", "color": "gold"}, {"text": "[ENABLED] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 3"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 3"}}]
execute unless data storage fb:config {debug:{cd:1b}} run tellraw @s ["", {"text": "  Countdown: ", "color": "gold"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 3"}}, {"text": "[DISABLED]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 3"}}]

# 4. Master Event Debug Row
execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "  Events Master: ", "color": "gold"}, {"text": "[ENABLED] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 4"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 4"}}]
execute unless data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "  Events Master: ", "color": "gold"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 4"}}, {"text": "[DISABLED]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 4"}}]

# 5. Fine-Grained Event Sub-Settings (shown if Master Event Debug is enabled)
execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "    ├─ Only Log Triggered Events: ", "color": "gray"}]
execute if data storage fb:config {debug:{event:1b, event_only_success:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 5"}}, {"text": "[OFF]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 5"}}, {"text": " (Silent when no callback matches)", "color": "dark_gray"}]
execute if data storage fb:config {debug:{event:1b}} unless data storage fb:config {debug:{event_only_success:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 5"}}, {"text": "[OFF]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 5"}}, {"text": " (Log all ticks and checks)", "color": "dark_gray"}]

execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "    ├─ Show NBT Matcher Breakdown: ", "color": "gray"}]
execute if data storage fb:config {debug:{event:1b, event_show_matcher:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 6"}}, {"text": "[OFF]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 6"}}, {"text": " (Show Item ID & custom_data checks)", "color": "dark_gray"}]
execute if data storage fb:config {debug:{event:1b}} unless data storage fb:config {debug:{event_show_matcher:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 6"}}, {"text": "[OFF]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 6"}}, {"text": " (Hide matcher details)", "color": "dark_gray"}]

execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "    ├─ Show Registration Messages: ", "color": "gray"}]
execute if data storage fb:config {debug:{event:1b, event_show_register:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 7"}}, {"text": "[OFF]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 7"}}, {"text": " (Broadcast when registering callbacks)", "color": "dark_gray"}]
execute if data storage fb:config {debug:{event:1b}} unless data storage fb:config {debug:{event_show_register:1b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ON] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 7"}}, {"text": "[OFF]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 7"}}, {"text": " (Silent registrations)", "color": "dark_gray"}]

execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "    ├─ Debug 'onHoldItem' Events: ", "color": "gray"}]
execute if data storage fb:config {debug:{event:1b}} unless data storage fb:config {debug:{event_hold:0b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ENABLE] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 8"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 8"}}, {"text": " (Hold Item debug active)", "color": "dark_gray"}]
execute if data storage fb:config {debug:{event:1b, event_hold:0b}} run tellraw @s ["", {"text": "    │  ", "color": "gray"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 8"}}, {"text": "[DISABLE]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 8"}}, {"text": " (Hold Item debug muted)", "color": "dark_gray"}]

execute if data storage fb:config {debug:{event:1b}} run tellraw @s ["", {"text": "    └─ Debug 'onRightClick' Events: ", "color": "gray"}]
execute if data storage fb:config {debug:{event:1b}} unless data storage fb:config {debug:{event_rc:0b}} run tellraw @s ["", {"text": "       ", "color": "gray"}, {"text": "[ENABLE] ", "color": "green", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 9"}}, {"text": "[DISABLE]", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 9"}}, {"text": " (Right Click debug active)", "color": "dark_gray"}]
execute if data storage fb:config {debug:{event:1b, event_rc:0b}} run tellraw @s ["", {"text": "       ", "color": "gray"}, {"text": "[ENABLE] ", "color": "gray", "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 9"}}, {"text": "[DISABLE]", "color": "red", "bold": true, "clickEvent": {"action": "run_command", "value": "/trigger fb.debug.tg set 9"}}, {"text": " (Right Click debug muted)", "color": "dark_gray"}]

tellraw @s ["", {"text": "========================================", "color": "yellow", "bold": true}]
