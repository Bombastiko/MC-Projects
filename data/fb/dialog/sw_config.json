{
  "type": "minecraft:multi_action",
  "title": { "text": "Stopwatch Config Generator" },
  "body": {
    "type": "minecraft:plain_message",
    "contents": "Enter your stopwatch settings. Click the button to receive a copyable chat link."
  },
  "columns": 1,
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "player",
      "label": "Player (e.g. @a or name)",
      "initial": "@a"
    },
    {
      "type": "minecraft:text",
      "key": "sw",
      "label": "Stopwatch Name (e.g. demo)"
    },
    {
      "type": "minecraft:single_option",
      "key": "format",
      "label": "Format",
      "options": [
        { "id": "digital", "display": "Digital (HH:MM:SS)", "initial": true },
        { "id": "digital_short", "display": "Digital Short (MM:SS.ms)" },
        { "id": "letters", "display": "Letters (Xd Xh Xm Xs)" },
        { "id": "dynamic", "display": "Dynamic (auto-truncate)" }
      ]
    },
    {
      "type": "minecraft:single_option",
      "key": "color",
      "label": "Primary Color (Prefix/Suffix)",
      "options": [
        { "id": "gold", "display": "Gold", "initial": true },
        { "id": "yellow", "display": "Yellow" },
        { "id": "white", "display": "White" },
        { "id": "gray", "display": "Gray" },
        { "id": "red", "display": "Red" },
        { "id": "green", "display": "Green" },
        { "id": "blue", "display": "Blue" }
      ]
    },
    {
      "type": "minecraft:single_option",
      "key": "color_sec",
      "label": "Secondary Color (Separators)",
      "options": [
        { "id": "yellow", "display": "Yellow", "initial": true },
        { "id": "gold", "display": "Gold" },
        { "id": "white", "display": "White" },
        { "id": "gray", "display": "Gray" },
        { "id": "red", "display": "Red" },
        { "id": "green", "display": "Green" },
        { "id": "blue", "display": "Blue" }
      ]
    },
    {
      "type": "minecraft:single_option",
      "key": "color_num",
      "label": "Number Color",
      "options": [
        { "id": "white", "display": "White", "initial": true },
        { "id": "gold", "display": "Gold" },
        { "id": "yellow", "display": "Yellow" },
        { "id": "gray", "display": "Gray" },
        { "id": "red", "display": "Red" },
        { "id": "green", "display": "Green" },
        { "id": "blue", "display": "Blue" }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "prefix",
      "label": "Prefix (e.g. 'Timer: ')",
      "initial": "Timer: "
    },
    {
      "type": "minecraft:text",
      "key": "suffix",
      "label": "Suffix (e.g. ' elapsed')"
    },
    {
      "type": "minecraft:single_option",
      "key": "bold",
      "label": "Bold?",
      "options": [
        { "id": "false", "display": "No", "initial": true },
        { "id": "true", "display": "Yes" }
      ]
    }
  ],
  "actions": [
    {
      "label": "Generate Command",
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "tellraw @s [\"\",{\"text\":\"Your command was generated! \",\"color\":\"green\"},{\"text\":\"[CLICK HERE TO COPY]\",\"color\":\"yellow\",\"bold\":true,\"clickEvent\":{\"action\":\"copy_to_clipboard\",\"value\":\"/function fb:sw/display_ab_custom {player:'$(player)',sw:'$(sw)',format:'$(format)',color:'$(color)',color_sec:'$(color_sec)',color_num:'$(color_num)',prefix:'$(prefix)',suffix:'$(suffix)',bold:'$(bold)'}\"}}]"
      }
    }
  ]
}
